# Modelo de ambiente de PRODUÇÃO para o Securo atrás de um Cloudflare Tunnel.
# Copie para `deploy/public/.env`, preencha e proteja: `chmod 600 deploy/public/.env`.
# O `.env` real NUNCA deve ser commitado (já coberto pelo .gitignore do repositório).
#
# Uso:
#   docker compose -p securo-prod --env-file deploy/public/.env -f docker-compose.prod.yml up -d

# Gere cada valor com:  openssl rand -hex 32
# ATENÇÃO: o SECRET_KEY também deriva a chave que criptografa, dentro do banco, as conexões bancárias
# e as chaves de API dos agents. Guarde uma cópia no gerenciador de senhas; sem ele, um banco
# restaurado perde essas credenciais.
SECRET_KEY=
AGENTS_MCP_JWT_SECRET=

# URL pública EXATA (esquema + host, sem barra final). Controla CORS, callbacks OAuth e passkeys.
FRONTEND_URL=https://securo.example.com

# Publicar só no loopback: quem expõe o serviço é o túnel, não a rede local.
# (Use portas diferentes das do ambiente de desenvolvimento, se ele rodar na mesma máquina.)
FRONTEND_PORT=127.0.0.1:3100
BACKEND_PORT=127.0.0.1:8100

# Quantos proxies existem entre o cliente e o backend, para o rate limit ler o IP real do cliente.
# Cloudflare -> cloudflared -> nginx do frontend = 2. Valor maior que o real permite forjar o IP;
# menor faz todos compartilharem o mesmo limite. Valide como descrito no README.
TRUSTED_PROXY_HOPS=2

# Recursos opcionais de IA desligados por padrão.
AGENTS_ENABLED=false

# Imagens do Docker: dono no GHCR e versão (lidos por deploy/public/compose.images.yml).
# Padrão = imagens oficiais do projeto em `latest`. Em PRODUÇÃO FIXE a versão, para que um `pull` não traga
# uma release nova sem você ter lido as notas e feito backup. Se publica releases do seu fork, o dono é o seu
# usuário do GitHub e a versão é a da sua release (ex.: 0.16.3-selfhost.1). Ver RELEASING.md.
SECURO_IMAGE_OWNER=securo-finance
SECURO_IMAGE_TAG=latest
